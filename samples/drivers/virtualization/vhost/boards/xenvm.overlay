/ {
	vhost_rng: vhost-rng@2000000 {
		compatible = "xen,vhost-mmio";
		reg = <0x00 0x2000000 0x00 0x1000>;
		device-id = <4>;
		vendor-id = <0x7a707972>; /* "zphy" */
		num-queues = <1>;
		queue-size-max = <16>;
	};

	chosen {
		zephyr,shell-uart = &xen_hvc;
	};
};
