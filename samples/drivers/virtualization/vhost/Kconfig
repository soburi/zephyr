mainmenu "Vhost sample"

config VHOST_BLK_DISK_BACKEND
	bool
	default y if DT_HAS_ZEPHYR_VHOST_BLK_DISK_ENABLED
	select DISK_ACCESS

config VHOST_BLK_FILE_BACKEND
	bool
	default y if DT_HAS_ZEPHYR_VHOST_BLK_FILE_ENABLED
	select FILE_SYSTEM

source "Kconfig.zephyr"
