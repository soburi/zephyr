/ {
	pcie0 {
		qemu_epc: epc {
			compatible = "qemu,pci-epc";
			max-functions = <8>;

			vendor-id = <0x1b36>;
			device-id = <0x0015>;

			status = "okay";
		};
	};

	vhost_rng: vhost-rng {
		compatible = "zephyr,vhost-pci-epf";
		epc = <&qemu_epc>;
		device-id = <4>; /* entropy source */
		queue-size-max = <16>;
	};
};
