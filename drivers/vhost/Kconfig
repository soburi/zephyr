config VHOST
	bool "VHost (VIRTIO backend) drivers"
	help
	  Enable VHost drivers, which implement the host (device) side of
	  VIRTIO transports so that Zephyr can act as a VIRTIO device backend.

if VHOST

config VHOST_CHAIN_BUFS_MAX
	int "Maximum number of buffers in a descriptor chain"
	default 8
	range 1 1024
	help
	  Upper bound for the number of buffers (descriptors) in a single
	  VIRTIO descriptor chain that VHost backends are able to process.
	  Longer chains are rejected with -E2BIG. This bound allows backends
	  to use statically allocated mapping structures instead of
	  allocating from the heap in the datapath.

config VHOST_XEN_MMIO
	bool "MMIO-based VIRTIO backend on Xen hypervisor"
	default y
	depends on DT_HAS_XEN_VHOST_MMIO_ENABLED
	select XEN_STORE_CLI
	select XEN_DMOP
	select XEN_TOOLS
	help
	  Enable the VIRTIO-MMIO backend on the Xen hypervisor. The backend
	  serves VIRTIO-MMIO register accesses of a guest domain through an
	  IOREQ server and accesses guest buffers via the grant table.

	  Consider enabling XEN_REGIONS so that grant mappings are placed in
	  Xen extended regions instead of consuming heap pages.

if VHOST_XEN_MMIO

config VHOST_XEN_MMIO_BUF_PAGES_MAX
	int "Maximum number of pages in a single buffer"
	default 4
	range 1 64
	help
	  Upper bound for the number of grant pages a single VIRTIO buffer
	  (one descriptor) may span. Buffers exceeding the bound are rejected
	  with -E2BIG. Note that the virtqueue rings themselves are also
	  mapped through this path, so this value must cover
	  DIV_ROUND_UP(8 * queue-size-max + 6, 4096) pages for the used ring.

config VHOST_XEN_MMIO_INFLIGHT_CHAINS_MAX
	int "Maximum number of in-flight descriptor chains per queue"
	default 16
	range 1 1024
	help
	  Number of descriptor chains per queue that can be mapped
	  concurrently (between vhost_prepare_iovec() and
	  vhost_release_iovec()). The mapping bookkeeping is allocated
	  statically from a memory slab sized by this value.

config VHOST_XEN_MMIO_VCPUS_MAX
	int "Maximum number of frontend vCPUs"
	default 4
	range 1 128
	help
	  Maximum number of vCPUs of the frontend domain. One IOREQ event
	  channel is bound per frontend vCPU.

endif # VHOST_XEN_MMIO

config VHOST_PCI_EPF
	bool "VIRTIO legacy PCI backend over a PCI endpoint function"
	default y
	depends on DT_HAS_ZEPHYR_VHOST_PCI_EPF_ENABLED
	depends on !BIG_ENDIAN
	select PCI_EPF
	help
	  Expose a VHost backend as a legacy (transitional) virtio-pci
	  function through the PCI Endpoint Function framework. A host
	  connected to the endpoint port enumerates a virtio-pci device
	  whose virtqueues are served by this Zephyr device.

	  The legacy register interface is emulated in a memory-backed
	  BAR that is polled for changes; virtqueue rings and buffers in
	  host memory are accessed through the endpoint controller's
	  outbound windows. MSI-X support in the endpoint controller is
	  required for host interrupt delivery.

if VHOST_PCI_EPF

config VHOST_PCI_EPF_POLL_PERIOD_US
	int "Register poll period in microseconds"
	default 500
	range 10 1000000
	help
	  Period at which the BAR register block is polled for host
	  writes. Host register writes do not generate events on the
	  endpoint, so this value bounds the latency of queue
	  notifications and configuration changes.

config VHOST_PCI_EPF_INFLIGHT_CHAINS_MAX
	int "Maximum number of in-flight descriptor chains per queue"
	default 16
	range 1 1024
	help
	  Number of descriptor chains per queue that can be mapped
	  concurrently (between vhost_prepare_iovec() and
	  vhost_release_iovec()). The mapping bookkeeping is allocated
	  statically from a memory slab sized by this value.

config VHOST_PCI_EPF_INIT_PRIORITY
	int "Init priority"
	default 99
	help
	  Device initialization priority. Must be higher (later) than the
	  initialization priority of the PCI endpoint controller driver,
	  because the endpoint function can only bind to an already
	  registered controller.

endif # VHOST_PCI_EPF

endif # VHOST

module = VHOST
module-str = VHOST
source "subsys/logging/Kconfig.template.log_config"
