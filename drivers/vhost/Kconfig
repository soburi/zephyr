menuconfig VHOST
	bool "VHost (VIRTIO backend) controller drivers"
	help
	  Enable VHost controller drivers. A VHost controller provides the
	  hypervisor-specific transport for implementing VIRTIO device
	  backends that serve VIRTIO drivers running in guest virtual
	  machines.

if VHOST

config VHOST_XEN_MMIO
	bool "Xen MMIO VIRTIO backend controller"
	default y
	depends on DT_HAS_XEN_VHOST_MMIO_ENABLED
	depends on XEN_DOM0
	select XEN_STORE_CLI
	select XEN_DMOP
	help
	  Enable the VHost controller that implements a VIRTIO MMIO device
	  backend on the Xen hypervisor, using the ioreq server interface to
	  emulate the MMIO register window and the grant table interface to
	  access guest buffers.

config VHOST_PCI_EPF
	bool "VIRTIO PCI endpoint function controller"
	default y
	depends on DT_HAS_ZEPHYR_VHOST_PCI_EPF_ENABLED
	depends on PCIE_EPC
	help
	  Enable the VHost controller that exposes a VIRTIO PCI device to the
	  PCI host through a function of a PCI endpoint controller. The
	  function implements the VIRTIO PCI interface, serves the register
	  accesses of the driver, and accesses the driver buffers through the
	  outbound address windows of the endpoint controller. It needs an
	  endpoint controller that services BAR accesses in software.

config VHOST_PCI_EPF_INIT_PRIORITY
	int "VIRTIO PCI endpoint function controller init priority"
	default 90
	depends on VHOST_PCI_EPF
	help
	  Initialization priority of the VIRTIO PCI endpoint function
	  controller. It must be larger than PCIE_EPC_INIT_PRIORITY.

module = VHOST
module-str = VHOST
source "subsys/logging/Kconfig.template.log_config"

endif # VHOST
