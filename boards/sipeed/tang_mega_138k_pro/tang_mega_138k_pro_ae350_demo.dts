/dts-v1/;

#include "tang_mega_138k_pro_ae350.dts"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Sipeed Tang Mega 138K Pro Dock AE350 Demo";
	compatible = "sipeed,tang-mega-138k-pro-ae350-demo";

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		sw0 = &key0;
		sw1 = &key1;
		sw2 = &key2;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			label = "LED 1";
		};

		led1: led_1 {
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			label = "LED 2";
		};

		led2: led_2 {
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
			label = "LED 3";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		key0: key_0 {
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			label = "S0";
			zephyr,code = <INPUT_KEY_0>;
		};

		key1: key_1 {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			label = "S1";
			zephyr,code = <INPUT_KEY_1>;
		};

		key2: key_2 {
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			label = "S2";
			zephyr,code = <INPUT_KEY_2>;
		};
	};
};

&spiflash {
	reg = <0x80000000 DT_SIZE_M(10)>;
};

&dram {
	reg = <0x00000000 DT_SIZE_M(256)>;
};

&uart1 {
	clock-frequency = <50000000>;
	current-speed = <115200>;
	status = "okay";
};

&gpio0 {
	ngpios = <6>;
	status = "okay";
};

&spi0 {
	/*
	 * The configuration flash the FPGA boots from. The bitstream occupies the start of the
	 * chip and maps the rest into the read-only window spiflash describes, so the xip
	 * partition and spiflash are the same storage under two addresses. This layout is what
	 * the flash programmer needs; the link address comes from spiflash, which is why this
	 * is not the zephyr,code-partition.
	 */
	config_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		size = <DT_SIZE_M(128)>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			bitstream_partition: partition@0 {
				label = "fpga_bitstream";
				reg = <0x0 DT_SIZE_M(6)>;
				read-only;
			};

			xip_partition: partition@600000 {
				label = "xip";
				reg = <0x600000 DT_SIZE_M(10)>;
			};
		};
	};
};
